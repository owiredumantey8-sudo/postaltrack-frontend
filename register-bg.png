no"><pre dir="ltr"><code dir="ltr"><span>import React from "react";
import { Link } from "react-router-dom";

function Home() {
  return (
    &lt;div
      style={{
        minHeight: "100vh",
        background: "linear-gradient(135deg,#081c15,#1b4332,#2d6a4f)",
        color: "white",
        fontFamily: "Arial, sans-serif",
      }}
    &gt;
      {/* NAVBAR */}
      &lt;nav
        style={{
          display: "flex",
          justifyContent: "space-between",
          alignItems: "center",
          padding: "20px 8%",
          background: "rgba(0,0,0,0.2)",
        }}
      &gt;
        &lt;h2&gt;
          Postal&lt;span style={{ color: "#95d5b2" }}&gt;Track&lt;/span&gt;
        &lt;/h2&gt;

        &lt;div style={{ display: "flex", gap: "10px" }}&gt;
          &lt;Link to="/login"&gt;
            &lt;button
              style={{
                padding: "10px 20px",
                borderRadius: "8px",
                border: "none",
                cursor: "pointer",
              }}
            &gt;
              Login
            &lt;/button&gt;
          &lt;/Link&gt;

          &lt;Link to="/register"&gt;
            &lt;button
              style={{
                padding: "10px 20px",
                borderRadius: "8px",
                border: "none",
                background: "#52b788",
                color: "white",
                cursor: "pointer",
              }}
            &gt;
              Register
            &lt;/button&gt;
          &lt;/Link&gt;
        &lt;/div&gt;
      &lt;/nav&gt;

      {/* HERO SECTION */}
      &lt;div
        style={{
          display: "flex",
          justifyContent: "space-between",
          alignItems: "center",
          flexWrap: "wrap",
          padding: "100px 8%",
          gap: "40px",
        }}
      &gt;
        {/* LEFT */}
        &lt;div style={{ flex: 1, minWidth: "300px" }}&gt;
          &lt;h1
            style={{
              fontSize: "4rem",
              fontWeight: "bold",
              lineHeight: "1.1",
            }}
          &gt;
            Ghana's Smartest &lt;br /&gt;
            Courier Tracking System
          &lt;/h1&gt;

          &lt;p
            style={{
              marginTop: "20px",
              lineHeight: "1.8",
              color: "rgba(255,255,255,0.8)",
            }}
          &gt;
            Track parcels in real-time, receive instant notifications,
            and manage deliveries easily across Ghana.
          &lt;/p&gt;

          &lt;div
            style={{
              marginTop: "30px",
              display: "flex",
              gap: "15px",
            }}
          &gt;
            &lt;Link to="/track"&gt;
              &lt;button
                style={{
                  padding: "14px 28px",
                  background: "#52b788",
                  border: "none",
                  borderRadius: "10px",
                  color: "white",
                  cursor: "pointer",
                  fontWeight: "bold",
                }}
              &gt;
                Track Parcel
              &lt;/button&gt;
            &lt;/Link&gt;

            &lt;Link to="/register"&gt;
              &lt;button
                style={{
                  padding: "14px 28px",
                  background: "transparent",
                  border: "1px solid white",
                  borderRadius: "10px",
                  color: "white",
                  cursor: "pointer",
                }}
              &gt;
                Create Account
              &lt;/button&gt;
            &lt;/Link&gt;
          &lt;/div&gt;
        &lt;/div&gt;

        {/* RIGHT CARD */}
        &lt;div
          style={{
            width: "340px",
            background: "rgba(255,255,255,0.1)",
            padding: "30px",
            borderRadius: "20px",
            backdropFilter: "blur(20px)",
          }}
        &gt;
          &lt;h3 style={{ marginBottom: "20px", color: "#95d5b2" }}&gt;
            TRACKING STATUS
          &lt;/h3&gt;

          &lt;p&gt;&lt;strong&gt;TRK-2026-889211&lt;/strong&gt;&lt;/p&gt;

          &lt;div style={{ marginTop: "20px" }}&gt;
            &lt;p&gt;✅ Parcel Booked&lt;/p&gt;
            &lt;p&gt;✅ Dispatched&lt;/p&gt;
            &lt;p&gt;✅ In Transit&lt;/p&gt;
            &lt;p&gt;🟡 Out for Delivery&lt;/p&gt;
          &lt;/div&gt;
        &lt;/div&gt;
      &lt;/div&gt;

      {/* FEATURES */}
      &lt;div
        style={{
          padding: "80px 8%",
          textAlign: "center",
        }}
      &gt;
        &lt;h2 style={{ fontSize: "2.5rem" }}&gt;
          Why Choose PostalTrack?
        &lt;/h2&gt;

        &lt;div
          style={{
            display: "flex",
            justifyContent: "center",
            gap: "20px",
            flexWrap: "wrap",
            marginTop: "50px",
          }}
        &gt;
          {<span data-placeholder-token="true" class="text-token-text-primary cursor-text rounded-sm" style="background-color: color-mix(in srgb, var(--theme-user-selection-bg, var(--selection)) 30%, transparent); padding-top: 4px; padding-bottom: 4px;">[
            "Real-Time Tracking",
            "Fast Delivery",
            "Secure Handling",
            "Email Notifications",
          ]</span>.map((item, index) =&gt; (
            &lt;div
              key={index}
              style={{
                width: "220px",
                background: "rgba(255,255,255,0.08)",
                padding: "25px",
                borderRadius: "16px",
              }}
            &gt;
              &lt;h3&gt;{item}&lt;/h3&gt;
            &lt;/div&gt;
          ))}
        &lt;/div&gt;
      &lt;/div&gt;

      {/* FOOTER */}
      &lt;footer
        style={{
          textAlign: "center",
          padding: "20px",
          borderTop: "1px solid rgba(255,255,255,0.1)",
        }}
      &gt;
        © 2026 PostalTrack Ghana 🇬🇭
      &lt;/footer&gt;
    &lt;/div&gt;
  );
}

export default Home;</span></code></pre></div></div><div aria-hidden="true" class="pointer-events-none absolute inset-0 z-2 rounded-[24px] shadow-[inset_0px_0px_0px_1px_rgba(0,0,0,0.07)]"></div></div></div>
