  };

  return (
    &lt;div style={{ fontFamily: "'Segoe UI', Arial, sans-serif", overflowX: 'hidden', margin: 0, padding: 0 }}&gt;

      {/* NAVBAR */}
      &lt;nav style={{
        display: 'flex', justifyContent: 'space-between', alignItems: 'center',
        padding: '16px 80px',
        background: 'rgba(15,40,25,0.6)',
        backdropFilter: 'blur(30px)',
        WebkitBackdropFilter: 'blur(30px)',
        position: 'fixed', top: 0, left: 0, right: 0, zIndex: 100,
        borderBottom: '1px solid rgba(255,255,255,0.1)',
      }}&gt;
        &lt;div style={{ display: 'flex', alignItems: 'center', gap: '10px' }}&gt;
          &lt;svg width="32" height="32" viewBox="0 0 24 24" fill="none"&gt;
            &lt;path d="M20 7H4C2.9 7 2 7.9 2 9V19C2 20.1 2.9 21 4 21H20C21.1 21 22 20.1 22 19V9C22 7.9 21.1 7 20 7Z" fill="#74c69d" stroke="#52b788" strokeWidth="1.5"/&gt;
            &lt;path d="M16 7V5C16 3.9 15.1 3 14 3H10C8.9 3 8 3.9 8 5V7" stroke="#52b788" strokeWidth="1.5" strokeLinecap="round"/&gt;
            &lt;path d="M12 12V16M10 14H14" stroke="white" strokeWidth="1.5" strokeLinecap="round"/&gt;
          &lt;/svg&gt;
          &lt;span style={{ color: 'white', fontSize: '1.5rem', fontWeight: '800', letterSpacing: '-0.5px' }}&gt;
            Postal&lt;span style={{ color: '#95d5b2' }}&gt;Track&lt;/span&gt;
          &lt;/span&gt;
        &lt;/div&gt;
        &lt;div style={{ display: 'flex', gap: '10px', alignItems: 'center' }}&gt;
          &lt;Link to="/track" style={{ textDecoration: 'none' }}&gt;
            &lt;span style={{ color: 'rgba(255,255,255,0.8)', fontSize: '0.9rem', padding: '8px 16px', cursor: 'pointer' }}&gt;Track Parcel&lt;/span&gt;
          &lt;/Link&gt;
          {token ? (
            &lt;&gt;
              &lt;Link to="/dashboard" style={{ textDecoration: 'none' }}&gt;
                &lt;button style={{
                  padding: '9px 22px',
                  background: 'rgba(116,198,157,0.2)',
                  color: '#95d5b2', border: '1px solid rgba(116,198,157,0.4)',
                  borderRadius: '8px', cursor: 'pointer', fontWeight: '600', fontSize: '0.88rem'
                }}&gt;Dashboard&lt;/button&gt;
              &lt;/Link&gt;
              &lt;button onClick={handleLogout} style={{
                padding: '9px 22px',
                background: 'rgba(255,100,100,0.2)',
                color: '#ffaaaa', border: '1px solid rgba(255,100,100,0.3)',
                borderRadius: '8px', cursor: 'pointer', fontWeight: '600', fontSize: '0.88rem'
              }}&gt;Logout&lt;/button&gt;
            &lt;/&gt;
          ) : (
            &lt;&gt;
              &lt;Link to="/login" style={{ textDecoration: 'none' }}&gt;
                &lt;button style={{
                  padding: '9px 22px', background: 'transparent',
                  color: 'rgba(255,255,255,0.85)', border: '1px solid rgba(255,255,255,0.25)',
                  borderRadius: '8px', cursor: 'pointer', fontWeight: '500', fontSize: '0.88rem'
                }}&gt;Sign In&lt;/button&gt;
              &lt;/Link&gt;
              &lt;Link to="/register" style={{ textDecoration: 'none' }}&gt;
                &lt;button style={{
                  padding: '9px 22px',
                  background: 'linear-gradient(135deg, #52b788, #95d5b2)',
                  color: 'white', border: 'none',
                  borderRadius: '8px', cursor: 'pointer', fontWeight: '700', fontSize: '0.88rem',
                  boxShadow: '0 4px 15px rgba(82,183,136,0.45)'
                }}&gt;Get Started&lt;/button&gt;
              &lt;/Link&gt;
            &lt;/&gt;
          )}
        &lt;/div&gt;
      &lt;/nav&gt;

      {/* HERO - TROPICAL NATURE INSPIRED */}
      &lt;div style={{
        minHeight: '100vh',
        background: <code class="user-message-inline-code">
</code>          radial-gradient(ellipse at 10% 40%, rgba(255,200,80,0.18) 0%, transparent 40%),
          radial-gradient(ellipse at 90% 10%, rgba(100,220,200,0.2) 0%, transparent 35%),
          radial-gradient(ellipse at 60% 70%, rgba(30,120,80,0.35) 0%, transparent 45%),
          radial-gradient(ellipse at 20% 80%, rgba(0,100,80,0.3) 0%, transparent 40%),
          radial-gradient(ellipse at 80% 60%, rgba(20,80,120,0.25) 0%, transparent 40%),
          linear-gradient(150deg, 
            #1a4d2e 0%, 
            #2d7a4f 15%, 
            #3a9162 30%, 
            #2a6e55 45%, 
            #1e5f74 60%, 
            #134a6e 75%, 
            #0f3854 100%
          )
        <code class="user-message-inline-code">,
</code>        display: 'flex', alignItems: 'center',
        padding: '0 80px', paddingTop: '80px',
        position: 'relative', overflow: 'hidden'
      }}&gt;

        {/* SUNLIGHT RAY FROM TOP RIGHT */}
        &lt;div style={{
          position: 'absolute', top: '-100px', right: '10%',
          width: '500px', height: '700px',
          background: 'linear-gradient(180deg, rgba(255,220,100,0.12) 0%, transparent 70%)',
          transform: 'rotate(-20deg)',
          filter: 'blur(30px)', pointerEvents: 'none'
        }} /&gt;
        &lt;div style={{
          position: 'absolute', top: '-50px', right: '25%',
          width: '200px', height: '500px',
          background: 'linear-gradient(180deg, rgba(255,235,150,0.08) 0%, transparent 60%)',
          transform: 'rotate(-10deg)',
          filter: 'blur(20px)', pointerEvents: 'none'
        }} /&gt;

        {/* WATER SHIMMER BOTTOM */}
        &lt;div style={{
          position: 'absolute', bottom: 0, left: 0, right: 0, height: '200px',
          background: 'linear-gradient(0deg, rgba(20,80,120,0.4) 0%, transparent 100%)',
          filter: 'blur(20px)', pointerEvents: 'none'
        }} /&gt;

        {/* FOLIAGE TONES */}
        &lt;div style={{
          position: 'absolute', top: '10%', left: '-5%',
          width: '400px', height: '600px', borderRadius: '50%',
          background: 'radial-gradient(circle, rgba(34,120,60,0.25) 0%, transparent 70%)',
          filter: 'blur(50px)', pointerEvents: 'none'
        }} /&gt;
        &lt;div style={{
          position: 'absolute', bottom: '5%', right: '-5%',
          width: '350px', height: '500px', borderRadius: '50%',
          background: 'radial-gradient(circle, rgba(20,80,100,0.3) 0%, transparent 70%)',
          filter: 'blur(50px)', pointerEvents: 'none'
        }} /&gt;

        {/* GRID TEXTURE */}
        &lt;div style={{
          position: 'absolute', inset: 0, opacity: 0.15,
          backgroundImage: <code class="user-message-inline-code">radial-gradient(rgba(255,255,255,0.4) 1px, transparent 1px)</code>,
          backgroundSize: '35px 35px', pointerEvents: 'none'
        }} /&gt;

        {/* LEFT CONTENT */}
        &lt;div style={{ flex: 1, position: 'relative', zIndex: 2, maxWidth: '580px' }}&gt;
          &lt;div style={{
            display: 'inline-flex', alignItems: 'center', gap: '8px',
            background: 'rgba(149,213,178,0.15)',
            border: '1px solid rgba(149,213,178,0.35)',
            borderRadius: '50px', padding: '7px 18px', marginBottom: '32px'
          }}&gt;
            &lt;div style={{
              width: '8px', height: '8px', borderRadius: '50%',
              background: '#95d5b2', boxShadow: '0 0 10px #95d5b2'
            }} /&gt;
            &lt;span style={{ color: '#95d5b2', fontSize: '0.85rem', fontWeight: '600' }}&gt;Live Tracking Available Now&lt;/span&gt;
          &lt;/div&gt;

          &lt;h1 style={{
            fontSize: '4rem', fontWeight: '900', color: 'white',
            lineHeight: '1.1', letterSpacing: '-2px', margin: '0 0 24px',
            textShadow: '0 4px 20px rgba(0,0,0,0.4)'
          }}&gt;
            Ghana's Most&lt;br /&gt;
            &lt;span style={{
              background: 'linear-gradient(90deg, #95d5b2, #d8f3dc, #74c69d)',
              WebkitBackgroundClip: 'text', WebkitTextFillColor: 'transparent'
            }}&gt;Trusted Courier&lt;/span&gt;&lt;br /&gt;
            Tracking System
          &lt;/h1&gt;

          &lt;p style={{
            fontSize: '1.1rem', color: 'rgba(255,255,255,0.72)',
            lineHeight: '1.85', marginBottom: '45px', maxWidth: '460px'
          }}&gt;
            Book parcels, track shipments in real-time, and receive instant delivery notifications — all in one platform built for Ghana.
          &lt;/p&gt;

          &lt;div style={{ display: 'flex', gap: '15px', flexWrap: 'wrap' }}&gt;
            &lt;Link to="/track" style={{ textDecoration: 'none' }}&gt;
              &lt;button style={{
                padding: '16px 38px', fontSize: '1rem', fontWeight: '700',
                background: 'linear-gradient(135deg, #52b788, #95d5b2)',
                color: 'white', border: 'none', borderRadius: '10px',
                cursor: 'pointer',
                boxShadow: '0 10px 30px rgba(82,183,136,0.5)',
                display: 'flex', alignItems: 'center', gap: '10px'
              }}&gt;
                &lt;svg width="20" height="20" viewBox="0 0 24 24" fill="none"&gt;
                  &lt;circle cx="11" cy="11" r="8" stroke="white" strokeWidth="2.5"/&gt;
                  &lt;path d="M21 21L16.65 16.65" stroke="white" strokeWidth="2.5" strokeLinecap="round"/&gt;
                &lt;/svg&gt;
                Track a Parcel
              &lt;/button&gt;
            &lt;/Link&gt;
            &lt;Link to="/register" style={{ textDecoration: 'none' }}&gt;
              &lt;button style={{
                padding: '16px 38px', fontSize: '1rem', fontWeight: '600',
                background: 'rgba(255,255,255,0.1)',
                color: 'white', border: '1px solid rgba(255,255,255,0.25)',
                borderRadius: '10px', cursor: 'pointer',
                backdropFilter: 'blur(10px)',
                display: 'flex', alignItems: 'center', gap: '10px'
              }}&gt;
                &lt;svg width="20" height="20" viewBox="0 0 24 24" fill="none"&gt;
                  &lt;path d="M20 21V19C20 17.9 19.1 17 18 17H6C4.9 17 4 17.9 4 19V21" stroke="white" strokeWidth="2" strokeLinecap="round"/&gt;
                  &lt;circle cx="12" cy="9" r="4" stroke="white" strokeWidth="2"/&gt;
                  &lt;path d="M16 11H20M18 9V13" stroke="white" strokeWidth="2" strokeLinecap="round"/&gt;
                &lt;/svg&gt;
                Create Account
              &lt;/button&gt;
            &lt;/Link&gt;
          &lt;/div&gt;

          {/* STATS ROW */}
          &lt;div style={{ display: 'flex', gap: '0', marginTop: '55px' }}&gt;
            {[
              { num: '500+', label: 'Parcels Delivered' },
              { num: '100+', label: 'Happy Customers' },
              { num: '99%', label: 'Success Rate' },
            ].map((b, i) =&gt; (
              &lt;div key={i} style={{
                paddingRight: '35px',
                marginRight: '35px',
                borderRight: i &lt; 2 ? '1px solid rgba(255,255,255,0.15)' : 'none'
              }}&gt;
                &lt;div style={{ color: '#95d5b2', fontSize: '1.9rem', fontWeight: '800', lineHeight: 1 }}&gt;{b.num}&lt;/div&gt;
                &lt;div style={{ color: 'rgba(255,255,255,0.5)', fontSize: '0.78rem', marginTop: '5px', fontWeight: '500' }}&gt;{b.label}&lt;/div&gt;
              &lt;/div&gt;
            ))}
          &lt;/div&gt;
        &lt;/div&gt;

        {/* RIGHT - GLASS CARDS */}
        &lt;div style={{ flex: 1, display: 'flex', justifyContent: 'center', alignItems: 'center', position: 'relative', zIndex: 2 }}&gt;
          &lt;div style={{ position: 'relative', width: '400px', height: '520px' }}&gt;

            {/* MAIN TRACKING CARD */}
            &lt;div style={{
              position: 'absolute', top: '60px', left: '0',
              background: 'rgba(255,255,255,0.1)',
              backdropFilter: 'blur(40px)',
              WebkitBackdropFilter: 'blur(40px)',
              border: '1px solid rgba(255,255,255,0.2)',
              borderRadius: '24px', padding: '28px',
              boxShadow: '0 25px 60px rgba(0,0,0,0.3), 0 1px 0 rgba(255,255,255,0.15) inset',
              width: '290px'
            }}&gt;
              &lt;div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '18px' }}&gt;
                &lt;span style={{ color: 'rgba(255,255,255,0.55)', fontSize: '0.75rem', fontWeight: '700', letterSpacing: '1.5px' }}&gt;TRACKING STATUS&lt;/span&gt;
                &lt;div style={{
                  display: 'flex', alignItems: 'center', gap: '5px',
                  background: 'rgba(82,183,136,0.2)', borderRadius: '20px', padding: '3px 10px'
                }}&gt;
                  &lt;div style={{ width: '6px', height: '6px', borderRadius: '50%', background: '#52b788' }} /&gt;
                  &lt;span style={{ color: '#95d5b2', fontSize: '0.7rem', fontWeight: '600' }}&gt;LIVE&lt;/span&gt;
                &lt;/div&gt;
              &lt;/div&gt;
              &lt;div style={{ color: 'white', fontWeight: '700', fontSize: '0.95rem', marginBottom: '4px' }}&gt;TRK1778893294241&lt;/div&gt;
              &lt;div style={{ color: 'rgba(255,255,255,0.4)', fontSize: '0.8rem', marginBottom: '22px' }}&gt;Accra, Ghana → Kumasi&lt;/div&gt;

              {[
                { label: 'Parcel Booked', time: '8:00 AM', done: true },
                { label: 'Dispatched', time: '10:30 AM', done: true },
                { label: 'In Transit', time: '1:15 PM', done: true },
                { label: 'Out for Delivery', time: '--', done: false },
                { label: 'Delivered', time: '--', done: false },
              ].map((step, i) =&gt; (
                &lt;div key={i} style={{ display: 'flex', alignItems: 'center', gap: '12px', marginBottom: '14px' }}&gt;
                  &lt;div style={{
                    width: '22px', height: '22px', borderRadius: '50%', flexShrink: 0,
                    background: step.done ? 'linear-gradient(135deg, #52b788, #95d5b2)' : 'rgba(255,255,255,0.08)',
                    border: step.done ? 'none' : '1px solid rgba(255,255,255,0.15)',
                    display: 'flex', alignItems: 'center', justifyContent: 'center',
                    boxShadow: step.done ? '0 0 12px rgba(82,183,136,0.5)' : 'none'
                  }}&gt;
                    {step.done &amp;&amp; (
                      &lt;svg width="11" height="11" viewBox="0 0 24 24" fill="none"&gt;
                        &lt;path d="M5 12L10 17L20 7" stroke="white" strokeWidth="3" strokeLinecap="round" strokeLinejoin="round"/&gt;
                      &lt;/svg&gt;
                    )}
                  &lt;/div&gt;
                  &lt;div style={{ flex: 1 }}&gt;
                    &lt;span style={{ color: step.done ? 'white' : 'rgba(255,255,255,0.28)', fontSize: '0.85rem', fontWeight: step.done ? '600' : '400' }}&gt;{step.label}&lt;/span&gt;
                  &lt;/div&gt;
                  &lt;span style={{ color: 'rgba(255,255,255,0.3)', fontSize: '0.72rem' }}&gt;{step.time}&lt;/span&gt;
                &lt;/div&gt;
              ))}
            &lt;/div&gt;

            {/* EMAIL NOTIFICATION CARD */}
            &lt;div style={{
              position: 'absolute', bottom: '20px', right: '-25px',
              background: 'rgba(82,183,136,0.18)',
              backdropFilter: 'blur(30px)',
              WebkitBackdropFilter: 'blur(30px)',
              border: '1px solid rgba(149,213,178,0.3)',
              borderRadius: '18px', padding: '18px 20px',
              boxShadow: '0 15px 40px rgba(0,0,0,0.25)',
              width: '210px'
            }}&gt;
              &lt;div style={{ display: 'flex', alignItems: 'center', gap: '10px', marginBottom: '10px' }}&gt;
                &lt;div style={{
                  width: '38px', height: '38px', borderRadius: '10px',
                  background: 'linear-gradient(135deg, #52b788, #95d5b2)',
                  display: 'flex', alignItems: 'center', justifyContent: 'center',
                  flexShrink: 0
                }}&gt;
                  &lt;svg width="18" height="18" viewBox="0 0 24 24" fill="none"&gt;
                    &lt;path d="M20 4H4C2.9 4 2 4.9 2 6V18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V6C22 4.9 21.1 4 20 4Z" stroke="white" strokeWidth="2"/&gt;
                    &lt;path d="M2 6L12 13L22 6" stroke="white" strokeWidth="2" strokeLinecap="round"/&gt;
                  &lt;/svg&gt;
                &lt;/div&gt;
                &lt;div&gt;
                  &lt;div style={{ color: 'white', fontSize: '0.82rem', fontWeight: '700' }}&gt;Delivery Confirmed!&lt;/div&gt;
                  &lt;div style={{ color: 'rgba(255,255,255,0.45)', fontSize: '0.7rem' }}&gt;Just now · Email sent&lt;/div&gt;
                &lt;/div&gt;
              &lt;/div&gt;
              &lt;div style={{ color: 'rgba(255,255,255,0.65)', fontSize: '0.78rem', lineHeight: '1.55' }}&gt;
                Your parcel has been delivered successfully to the recipient.
              &lt;/div&gt;
            &lt;/div&gt;

            {/* DELIVERY TIME CARD */}
            &lt;div style={{
              position: 'absolute', top: '0', right: '-15px',
              background: 'rgba(255,220,100,0.12)',
              backdropFilter: 'blur(25px)',
              border: '1px solid rgba(255,220,100,0.25)',
              borderRadius: '16px', padding: '18px 22px',
              boxShadow: '0 15px 40px rgba(0,0,0,0.2)',
              textAlign: 'center'
            }}&gt;
              &lt;div style={{ color: '#ffd166', fontSize: '2.2rem', fontWeight: '900', lineHeight: 1 }}&gt;24h&lt;/div&gt;
              &lt;div style={{ color: 'rgba(255,255,255,0.5)', fontSize: '0.73rem', marginTop: '5px', fontWeight: '500' }}&gt;Avg Delivery&lt;/div&gt;
            &lt;/div&gt;

          &lt;/div&gt;
        &lt;/div&gt;
      &lt;/div&gt;

      {/* FEATURES */}
      &lt;div style={{
        padding: '90px 80px', textAlign: 'center',
        background: 'linear-gradient(180deg, #0f2a1a 0%, #162d20 50%, #112233 100%)',
      }}&gt;
        &lt;div style={{
          display: 'inline-block',
          background: 'rgba(149,213,178,0.1)',
          border: '1px solid rgba(149,213,178,0.25)',
          borderRadius: '50px', padding: '6px 18px', marginBottom: '18px'
        }}&gt;
          &lt;span style={{ color: '#95d5b2', fontSize: '0.8rem', fontWeight: '700', letterSpacing: '1.5px' }}&gt;OUR FEATURES&lt;/span&gt;
        &lt;/div&gt;
        &lt;h2 style={{ color: 'white', fontSize: '2.6rem', fontWeight: '800', marginBottom: '12px', letterSpacing: '-1px' }}&gt;
          Everything You Need
        &lt;/h2&gt;
        &lt;p style={{ color: 'rgba(255,255,255,0.4)', fontSize: '1rem', marginBottom: '55px' }}&gt;
          Designed for customers and courier agents in Ghana
        &lt;/p&gt;

        &lt;div style={{ display: 'flex', justifyContent: 'center', gap: '20px', flexWrap: 'wrap' }}&gt;
          {[
            {
              svg: &lt;svg width="26" height="26" viewBox="0 0 24 24" fill="none"&gt;&lt;path d="M13 2L3 14H12L11 22L21 10H12L13 2Z" stroke="#95d5b2" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"/&gt;&lt;/svg&gt;,
              title: 'Fast Delivery',
              desc: 'Same-day and next-day delivery across all major cities in Ghana',
              glow: 'rgba(82,183,136,0.08)', border: 'rgba(82,183,136,0.18)', iconBg: 'rgba(82,183,136,0.12)'
            },
            {
              svg: &lt;svg width="26" height="26" viewBox="0 0 24 24" fill="none"&gt;&lt;path d="M21 10C21 17 12 23 12 23C12 23 3 17 3 10C3 6.13 7.03 3 12 3C16.97 3 21 6.13 21 10Z" stroke="#7ec8e3" strokeWidth="2"/&gt;&lt;circle cx="12" cy="10" r="3" stroke="#7ec8e3" strokeWidth="2"/&gt;&lt;/svg&gt;,
              title: 'Live Tracking',
              desc: 'Real-time tracking with location updates at every checkpoint',
              glow: 'rgba(126,200,227,0.08)', border: 'rgba(126,200,227,0.18)', iconBg: 'rgba(126,200,227,0.12)'
            },
            {
              svg: &lt;svg width="26" height="26" viewBox="0 0 24 24" fill="none"&gt;&lt;path d="M12 22C17.5 22 22 17.5 22 12C22 6.5 17.5 2 12 2C6.5 2 2 6.5 2 12C2 17.5 6.5 22 12 22Z" stroke="#d4a5f5" strokeWidth="2"/&gt;&lt;path d="M9 12L11 14L15 10" stroke="#d4a5f5" strokeWidth="2" strokeLinecap="round"/&gt;&lt;/svg&gt;,
              title: 'Secure &amp; Insured',
              desc: 'All parcels are insured and handled with care by certified agents',
              glow: 'rgba(212,165,245,0.08)', border: 'rgba(212,165,245,0.18)', iconBg: 'rgba(212,165,245,0.12)'
            },
            {
              svg: &lt;svg width="26" height="26" viewBox="0 0 24 24" fill="none"&gt;&lt;path d="M20 4H4C2.9 4 2 4.9 2 6V18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V6C22 4.9 21.1 4 20 4Z" stroke="#ffd166" strokeWidth="2"/&gt;&lt;path d="M2 6L12 13L22 6" stroke="#ffd166" strokeWidth="2" strokeLinecap="round"/&gt;&lt;/svg&gt;,
              title: 'Email Alerts',
              desc: 'Instant delivery confirmation and status update emails to recipients',
              glow: 'rgba(255,209,102,0.08)', border: 'rgba(255,209,102,0.18)', iconBg: 'rgba(255,209,102,0.12)'
            },
          ].map((f, i) =&gt; (
            &lt;div key={i} style={{
              background: f.glow,
              border: <code class="user-message-inline-code">1px solid ${f.border}</code>,
              padding: '36px 26px', borderRadius: '20px', width: '225px',
              textAlign: 'left',
              boxShadow: '0 10px 30px rgba(0,0,0,0.2)',
              backdropFilter: 'blur(10px)'
            }}&gt;
              &lt;div style={{
                width: '54px', height: '54px', borderRadius: '14px',
                background: f.iconBg, border: <code class="user-message-inline-code">1px solid ${f.border}</code>,
                display: 'flex', alignItems: 'center', justifyContent: 'center',
                marginBottom: '20px'
              }}&gt;{f.svg}&lt;/div&gt;
              &lt;h3 style={{ color: 'white', fontSize: '1rem', fontWeight: '700', marginBottom: '10px' }}&gt;{f.title}&lt;/h3&gt;
              &lt;p style={{ color: 'rgba(255,255,255,0.45)', fontSize: '0.85rem', lineHeight: '1.75', margin: 0 }}&gt;{f.desc}&lt;/p&gt;
            &lt;/div&gt;
          ))}
        &lt;/div&gt;
      &lt;/div&gt;

      {/* STATS */}
      &lt;div style={{
        padding: '80px 80px', textAlign: 'center',
        background: <code class="user-message-inline-code">
</code>          radial-gradient(ellipse at 30% 50%, rgba(34,120,60,0.3) 0%, transparent 60%),
          radial-gradient(ellipse at 70% 50%, rgba(20,80,120,0.25) 0%, transparent 55%),
          linear-gradient(135deg, #1a4d2e, #1e4060, #1a4d2e)
