<div class="group relative clear-both my-4 w-full overflow-visible"><div id="writing-block-e67132b5-ab98-4812-8df2-a5a73dc1b858" class="relative w-full overflow-clip rounded-[24px] bg-token-bg-primary dark:bg-[#2a2a2a] shadow-[0px_4px_80px_rgba(0,0,0,0.02)]" data-writing-block="true" data-testid="writing-block-container"><div class="z-1 md:sticky top-(--sticky-padding-top)" data-testid="writing-block-header-sticky-container"><div class="bg-token-bg-primary flex w-full items-center justify-between gap-3 font-sans dark:bg-[#2a2a2a] py-2.5 pe-3 sm:pe-1" data-testid="writing-block-header-surface" style="padding-left: calc(5 * var(--spacing));"><div class="flex grow gap-3 items-center"><div class="text-token-text-tertiary flex max-w-[75%] min-w-0 grow cursor-default items-center self-center text-sm font-medium"><div class="truncate">Writing</div></div></div><div class="flex shrink-0 items-center"><div class="flex items-center gap-1"><button class="gap-1 select-none text-sm font-medium text-token-text-primary hover:bg-token-bg-tertiary flex size-9 items-center justify-center rounded-full p-1.5 transition-colors disabled:opacity-40 disabled:hover:bg-transparent" aria-label="Copy" data-state="closed"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon-md"><use href="/cdn/assets/sprites-core-b2090418.svg#ce3544" fill="currentColor"></use></svg></button></div></div></div></div><div class="writing-block-editor markdown-new-styling relative flow-root pt-(--writing-block-editor-pt) pe-(--writing-block-editor-pr) pb-(--writing-block-editor-pb) ps-(--writing-block-editor-pl)" style="--writing-block-editor-pt: 0px; --writing-block-editor-pr: calc(5 * var(--spacing)); --writing-block-editor-pb: calc(4 * var(--spacing)); --writing-block-editor-pl: calc(5 * var(--spacing));"><div class="ProseMirror markdown prose dark:prose-invert w-full min-h-6 break-words focus:outline-none" contenteditable="true" aria-disabled="false" dir="auto" translate="no"><pre dir="ltr"><code dir="ltr"><span>import React from "react";
import { Link } from "react-router-dom";

function Home() {
  return (
    &lt;div
      style={{
        minHeight: "100vh",
        background: "linear-gradient(135deg, #081c15, #1b4332, #2d6a4f)",
        color: "white",
        fontFamily: "Arial, sans-serif",
      }}
    &gt;
      &lt;nav
        style={{
          display: "flex",
          justifyContent: "space-between",
          alignItems: "center",
          padding: "20px 8%",
          background: "rgba(0,0,0,0.2)",
        }}
      &gt;
        &lt;h2&gt;
          Postal&lt;span style={{ color: "#95d5b2" }}&gt;Track&lt;/span&gt;
        &lt;/h2&gt;

        &lt;div style={{ display: "flex", gap: "10px" }}&gt;
          &lt;Link to="/login"&gt;
            &lt;button&gt;Login&lt;/button&gt;
          &lt;/Link&gt;

          &lt;Link to="/register"&gt;
            &lt;button&gt;Register&lt;/button&gt;
          &lt;/Link&gt;
        &lt;/div&gt;
      &lt;/nav&gt;

      &lt;div
        style={{
          padding: "100px 8%",
        }}
      &gt;
        &lt;h1&gt;Welcome to PostalTrack Ghana 🇬🇭&lt;/h1&gt;

        &lt;p&gt;
          Track parcels and manage deliveries across Ghana.
        &lt;/p&gt;
      &lt;/div&gt;
    &lt;/div&gt;
  );
}

export default Home;</span></code></pre></div></div><div aria-hidden="true" class="pointer-events-none absolute inset-0 z-2 rounded-[24px] shadow-[inset_0px_0px_0px_1px_rgba(0,0,0,0.07)]"></div></div></div>
