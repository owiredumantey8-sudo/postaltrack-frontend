no"><pre dir="ltr"><code dir="ltr"><span>import React from "react";
import { Link, useNavigate } from "react-router-dom";

function Home() {
  const token = localStorage.getItem("token");
  const navigate = useNavigate();

  const handleLogout = () =&gt; {
    localStorage.removeItem("token");
    localStorage.removeItem("role");
    navigate("/login");
  };

  const styles = {
    page: {
      fontFamily: "'Segoe UI', sans-serif",
      background:
        "linear-gradient(135deg, #081c15 0%, #1b4332 50%, #2d6a4f 100%)",
      color: "white",
      minHeight: "100vh",
      overflowX: "hidden",
    },

    navbar: {
      display: "flex",
      justifyContent: "space-between",
      alignItems: "center",
      padding: "18px 8%",
      position: "fixed",
      width: "100%",
      top: 0,
      zIndex: 100,
      backdropFilter: "blur(20px)",
      background: "rgba(0,0,0,0.2)",
      borderBottom: "1px solid rgba(255,255,255,0.08)",
      boxSizing: "border-box",
    },

    logo: {
      fontSize: "1.6rem",
      fontWeight: "800",
      color: "#fff",
      letterSpacing: "-1px",
    },

    navButtons: {
      display: "flex",
      gap: "12px",
      alignItems: "center",
    },

    button: {
      padding: "10px 22px",
      borderRadius: "10px",
      border: "none",
      cursor: "pointer",
      fontWeight: "600",
      fontSize: "0.9rem",
      transition: "0.3s",
    },

    primaryBtn: {
      background: "linear-gradient(135deg, #52b788, #74c69d)",
      color: "white",
      boxShadow: "0 8px 20px rgba(82,183,136,0.35)",
    },

    secondaryBtn: {
      background: "rgba(255,255,255,0.08)",
      color: "white",
      border: "1px solid rgba(255,255,255,0.15)",
    },

    hero: {
      minHeight: "100vh",
      display: "flex",
      justifyContent: "space-between",
      alignItems: "center",
      padding: "120px 8% 80px",
      gap: "50px",
      flexWrap: "wrap",
    },

    heroLeft: {
      flex: 1,
      minWidth: "300px",
    },

    badge: {
      display: "inline-block",
      padding: "8px 18px",
      borderRadius: "50px",
      background: "rgba(116,198,157,0.15)",
      border: "1px solid rgba(116,198,157,0.3)",
      color: "#95d5b2",
      fontSize: "0.8rem",
      marginBottom: "24px",
      fontWeight: "600",
    },

    heading: {
      fontSize: "4rem",
      lineHeight: 1.1,
      fontWeight: "900",
      marginBottom: "20px",
      letterSpacing: "-2px",
    },

    gradientText: {
      background: "linear-gradient(90deg,#95d5b2,#d8f3dc)",
      WebkitBackgroundClip: "text",
      WebkitTextFillColor: "transparent",
    },

    heroText: {
      fontSize: "1.05rem",
      lineHeight: 1.8,
      color: "rgba(255,255,255,0.75)",
      maxWidth: "520px",
      marginBottom: "35px",
    },

    heroButtons: {
      display: "flex",
      gap: "16px",
      flexWrap: "wrap",
    },

    stats: {
      display: "flex",
      gap: "40px",
      marginTop: "55px",
      flexWrap: "wrap",
    },

    statItem: {
      display: "flex",
      flexDirection: "column",
    },

    statNumber: {
      fontSize: "2rem",
      fontWeight: "800",
      color: "#95d5b2",
    },

    statLabel: {
      fontSize: "0.85rem",
      color: "rgba(255,255,255,0.6)",
      marginTop: "5px",
    },

    heroRight: {
      flex: 1,
      display: "flex",
      justifyContent: "center",
      minWidth: "300px",
    },

    trackingCard: {
      width: "340px",
      background: "rgba(255,255,255,0.08)",
      backdropFilter: "blur(25px)",
      borderRadius: "24px",
      border: "1px solid rgba(255,255,255,0.12)",
      padding: "30px",
      boxShadow: "0 20px 50px rgba(0,0,0,0.3)",
    },

    trackingTitle: {
      color: "#95d5b2",
      fontWeight: "700",
      marginBottom: "20px",
      fontSize: "0.9rem",
      letterSpacing: "1px",
    },

    trackingCode: {
      fontSize: "1rem",
      fontWeight: "700",
      marginBottom: "25px",
    },

    trackingStep: {
      display: "flex",
      alignItems: "center",
      gap: "12px",
      marginBottom: "18px",
    },

    dot: {
      width: "16px",
      height: "16px",
      borderRadius: "50%",
      background: "#52b788",
      boxShadow: "0 0 10px rgba(82,183,136,0.5)",
    },

    stepText: {
      color: "rgba(255,255,255,0.8)",
      fontSize: "0.9rem",
    },

    section: {
      padding: "80px 8%",
      textAlign: "center",
    },

    sectionTitle: {
      fontSize: "2.5rem",
      fontWeight: "800",
      marginBottom: "15px",
    },

    sectionSub: {
      color: "rgba(255,255,255,0.6)",
      marginBottom: "50px",
    },

    featureGrid: {
      display: "flex",
      justifyContent: "center",
      gap: "25px",
      flexWrap: "wrap",
    },

    featureCard: {
      width: "250px",
      padding: "30px",
      borderRadius: "20px",
      background: "rgba(255,255,255,0.05)",
      border: "1px solid rgba(255,255,255,0.08)",
      backdropFilter: "blur(15px)",
      textAlign: "left",
    },

    featureTitle: {
      fontSize: "1.1rem",
      fontWeight: "700",
      marginBottom: "10px",
    },

    featureDesc: {
      color: "rgba(255,255,255,0.6)",
      lineHeight: 1.7,
      fontSize: "0.9rem",
    },

    footer: {
      padding: "30px 8%",
      borderTop: "1px solid rgba(255,255,255,0.08)",
      textAlign: "center",
      color: "rgba(255,255,255,0.5)",
      fontSize: "0.85rem",
    },
  };

  return (
    &lt;div style={styles.page}&gt;
      {/* NAVBAR */}
      &lt;nav style={styles.navbar}&gt;
        &lt;div style={styles.logo}&gt;
          Postal&lt;span style={{ color: "#95d5b2" }}&gt;Track&lt;/span&gt;
        &lt;/div&gt;

        &lt;div style={styles.navButtons}&gt;
          &lt;Link to="/track"&gt;
            &lt;button style={{ ...styles.button, ...styles.secondaryBtn }}&gt;
              Track Parcel
            &lt;/button&gt;
          &lt;/Link&gt;

          {token ? (
            &lt;&gt;
              &lt;Link to="/dashboard"&gt;
                &lt;button style={{ ...styles.button, ...styles.primaryBtn }}&gt;
                  Dashboard
                &lt;/button&gt;
              &lt;/Link&gt;

              &lt;button
                onClick={handleLogout}
                style={{
                  ...styles.button,
                  background: "#c1121f",
                  color: "white",
                }}
              &gt;
                Logout
              &lt;/button&gt;
            &lt;/&gt;
          ) : (
            &lt;&gt;
              &lt;Link to="/login"&gt;
                &lt;button style={{ ...styles.button, ...styles.secondaryBtn }}&gt;
                  Login
                &lt;/button&gt;
              &lt;/Link&gt;

              &lt;Link to="/register"&gt;
                &lt;button style={{ ...styles.button, ...styles.primaryBtn }}&gt;
                  Get Started
                &lt;/button&gt;
              &lt;/Link&gt;
            &lt;/&gt;
          )}
        &lt;/div&gt;
      &lt;/nav&gt;

      {/* HERO */}
      &lt;section style={styles.hero}&gt;
        &lt;div style={styles.heroLeft}&gt;
          &lt;div style={styles.badge}&gt;Live Parcel Tracking Available&lt;/div&gt;

          &lt;h1 style={styles.heading}&gt;
            Ghana's Smartest &lt;br /&gt;
            &lt;span style={styles.gradientText}&gt;Courier Tracking&lt;/span&gt; Platform
          &lt;/h1&gt;

          &lt;p style={styles.heroText}&gt;
            Send parcels, monitor deliveries in real-time, and receive instant
            shipment notifications anywhere in Ghana.
          &lt;/p&gt;

          &lt;div style={styles.heroButtons}&gt;
            &lt;Link to="/track"&gt;
              &lt;button style={{ ...styles.button, ...styles.primaryBtn }}&gt;
                Track Parcel
              &lt;/button&gt;
            &lt;/Link&gt;

            &lt;Link to="/register"&gt;
              &lt;button style={{ ...styles.button, ...styles.secondaryBtn }}&gt;
                Create Account
              &lt;/button&gt;
            &lt;/Link&gt;
          &lt;/div&gt;

          &lt;div style={styles.stats}&gt;
            &lt;div style={styles.statItem}&gt;
              &lt;span style={styles.statNumber}&gt;500+&lt;/span&gt;
              &lt;span style={styles.statLabel}&gt;Parcels Delivered&lt;/span&gt;
            &lt;/div&gt;

            &lt;div style={styles.statItem}&gt;
              &lt;span style={styles.statNumber}&gt;100+&lt;/span&gt;
              &lt;span style={styles.statLabel}&gt;Customers&lt;/span&gt;
            &lt;/div&gt;

            &lt;div style={styles.statItem}&gt;
              &lt;span style={styles.statNumber}&gt;99%&lt;/span&gt;
              &lt;span style={styles.statLabel}&gt;Delivery Rate&lt;/span&gt;
            &lt;/div&gt;
          &lt;/div&gt;
        &lt;/div&gt;

        {/* TRACKING CARD */}
        &lt;div style={styles.heroRight}&gt;
          &lt;div style={styles.trackingCard}&gt;
            &lt;div style={styles.trackingTitle}&gt;TRACKING STATUS&lt;/div&gt;

            &lt;div style={styles.trackingCode}&gt;
              TRK-2026-889211
            &lt;/div&gt;

            {<span data-placeholder-token="true" class="text-token-text-primary cursor-text rounded-sm" style="background-color: color-mix(in srgb, var(--theme-user-selection-bg, var(--selection)) 30%, transparent); padding-top: 4px; padding-bottom: 4px;">[
              "Parcel Booked",
              "Dispatched",
              "In Transit",
              "Out for Delivery",
            ]</span>.map((step, i) =&gt; (
              &lt;div key={i} style={styles.trackingStep}&gt;
                &lt;div style={styles.dot}&gt;&lt;/div&gt;
                &lt;span style={styles.stepText}&gt;{step}&lt;/span&gt;
              &lt;/div&gt;
            ))}
          &lt;/div&gt;
        &lt;/div&gt;
      &lt;/section&gt;

      {/* FEATURES */}
      &lt;section style={styles.section}&gt;
        &lt;h2 style={styles.sectionTitle}&gt;Why Choose PostalTrack?&lt;/h2&gt;

        &lt;p style={styles.sectionSub}&gt;
          Built for modern courier delivery services in Ghana
        &lt;/p&gt;

        &lt;div style={styles.featureGrid}&gt;
          {<span data-placeholder-token="true" class="text-token-text-primary cursor-text rounded-sm" style="background-color: color-mix(in srgb, var(--theme-user-selection-bg, var(--selection)) 30%, transparent); padding-top: 4px; padding-bottom: 4px;">[
            {
              title: "Real-Time Tracking",
              desc: "Track parcels instantly with live delivery updates.",
            },
            {
              title: "Fast Delivery",
              desc: "Same-day and next-day delivery options available.",
            },
            {
              title: "Secure Handling",
              desc: "Your parcels are handled safely and professionally.",
            },
            {
              title: "Email Alerts",
              desc: "Get notified immediately after delivery.",
            },
          ]</span>.map((item, index) =&gt; (
            &lt;div key={index} style={styles.featureCard}&gt;
              &lt;h3 style={styles.featureTitle}&gt;{item.title}&lt;/h3&gt;
              &lt;p style={styles.featureDesc}&gt;{item.desc}&lt;/p&gt;
            &lt;/div&gt;
          ))}
        &lt;/div&gt;
      &lt;/section&gt;

      {/* CTA */}
      &lt;section style={styles.section}&gt;
        &lt;h2 style={styles.sectionTitle}&gt;
          Ready to Deliver Across Ghana?
        &lt;/h2&gt;

        &lt;p style={styles.sectionSub}&gt;
          Join customers already using PostalTrack daily.
        &lt;/p&gt;

        &lt;Link to="/register"&gt;
          &lt;button style={{ ...styles.button, ...styles.primaryBtn }}&gt;
            Start Now
          &lt;/button&gt;
        &lt;/Link&gt;
      &lt;/section&gt;

      {/* FOOTER */}
      &lt;footer style={styles.footer}&gt;
        © 2026 PostalTrack — Online Postal Courier System Ghana 🇬🇭
      &lt;/footer&gt;
    &lt;/div&gt;
  );
}

export default Home;</span></code></pre></div></div><div aria-hidden="true" class="pointer-events-none absolute inset-0 z-2 rounded-[24px] shadow-[inset_0px_0px_0px_1px_rgba(0,0,0,0.07)]"></div></div></div></div></div></div></div><div class="z-0 flex min-h-[46px] justify-start"><div aria-label="Response actions" class="touch:-me-2 touch:-ms-3.5 -ms-2.5 -me-1 flex flex-wrap items-center gap-y-4 p-1 select-none touch:w-[calc(100%+--spacing(3.5))] -mt-1 w-[calc(100%+--spacing(2.5))] duration-[1.5s] focus-within:transition-none hover:transition-none touch:pointer-events-auto pointer-events-none [mask-image:linear-gradient(to_right,black_33%,transparent_66%)] [mask-size:300%_100%] [mask-position:100%_0%] motion-safe:transition-[mask-position] group-hover/turn-messages:pointer-events-auto group-hover/turn-messages:[mask-position:0_0] group-focus-within/turn-messages:pointer-events-auto group-focus-within/turn-messages:[mask-position:0_0] has-data-[state=open]:pointer-events-auto has-data-[state=open]:[mask-position:0_0]" role="group" tabindex="-1" style="mask-position: 0% 0%;"><button class="text-token-text-secondary hover:bg-token-bg-secondary rounded-lg" aria-label="Copy response" data-testid="copy-turn-action-button" data-state="closed"><span class="flex items-center justify-center touch:w-10 h-8 w-8"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon"><use href="/cdn/assets/sprites-core-b2090418.svg#ce3544" fill="currentColor"></use></svg></span></button><button class="text-token-text-secondary hover:bg-token-bg-secondary rounded-lg" aria-label="Good response" aria-pressed="false" data-testid="good-response-turn-action-button" data-state="closed"><span class="flex items-center justify-center touch:w-10 h-8 w-8"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon"><use href="/cdn/assets/sprites-core-b2090418.svg#51753c" fill="currentColor"></use></svg></span></button><button class="tex