mary w-full focus:outline-none has-data-writing-block:pointer-events-none [&amp;:has([data-writing-block])&gt;*]:pointer-events-auto R6Vx5W_threadScrollVars scroll-mb-[calc(var(--scroll-root-safe-area-inset-bottom,0px)+var(--thread-response-height))] scroll-mt-(--header-height)" dir="auto" data-turn-id="d1e77b6c-4953-4fc4-b32e-0254e10e90a6" data-turn-id-container="d1e77b6c-4953-4fc4-b32e-0254e10e90a6" data-testid="conversation-turn-3" data-scroll-anchor="false" data-turn="user"><h4 class="sr-only select-none">You said:</h4><div class="text-base my-auto mx-auto pt-12 [--thread-content-margin:var(--thread-content-margin-xs,calc(var(--spacing)*4))] @w-sm/main:[--thread-content-margin:var(--thread-content-margin-sm,calc(var(--spacing)*6))] @w-lg/main:[--thread-content-margin:var(--thread-content-margin-lg,calc(var(--spacing)*16))] px-(--thread-content-margin)"><div class="[--thread-content-max-width:40rem] @w-lg/main:[--thread-content-max-width:48rem] mx-auto max-w-(--thread-content-max-width) flex-1 group/turn-messages focus-visible:outline-hidden relative flex w-full min-w-0 flex-col"><div class="flex max-w-full flex-col gap-4 grow"><div data-message-author-role="user" data-message-id="d1e77b6c-4953-4fc4-b32e-0254e10e90a6" dir="auto" class="min-h-8 text-message relative flex w-full flex-col items-end gap-2 text-start break-words whitespace-normal outline-none keyboard-focused:focus-ring [.text-message+&amp;]:mt-1"><div class="flex w-full flex-col gap-1 empty:hidden items-end rtl:items-start"><div class="flex flex-col w-fit max-w-(--user-chat-width,70%) items-start self-end rtl:items-end rtl:self-start"><div class="user-message-bubble-color corner-superellipse/0.98 relative min-w-0 overflow-hidden rounded-[22px] px-4 py-2.5 leading-6 w-full"><div data-custom-highlighting-behavior="boundary" class="A_HxFq_root" data-testid="collapsible-user-message-root"><input id="_r_9b_" aria-controls="_r_9a_" class="A_HxFq_toggleCheckbox" data-testid="collapsible-user-message-toggle-checkbox" type="checkbox"><div id="_r_9a_" data-testid="collapsible-user-message-content" class="A_HxFq_content"><div class="max-w-full min-w-0 [overflow-wrap:anywhere] whitespace-pre-wrap">import React from 'react';
import { Link, useNavigate } from 'react-router-dom';

function Home() {
  const token = localStorage.getItem('token');
  const navigate = useNavigate();

  const handleLogout = () =&gt; {
    localStorage.removeItem('token');
    localStorage.removeItem('role');
    navigate('/login');
  };

  return (
    &lt;div style={{ fontFamily: "'Segoe UI', Arial, sans-serif", overflowX: 'hidden', margin: 0, padding: 0 }}&gt;

      {/* NAVBAR */}
      &lt;nav style={{
        display: 'flex', justifyContent: 'space-between', alignItems: 'center',
        padding: '16px 80px',
        background: 'rgba(15,40,25,0.6)',
        backdropFilter: 'blur(30px)',
        WebkitBackdropFilter: 'blur(30px)',
        position: 'fixed', top: 0, left: 0, right: 0, zIndex: 100,
        borderBottom: '1px solid rgba(255,255,255,0.1)',
      }}&gt;
        &lt;div style={{ display: 'flex', alignItems: 'center', gap: '10px' }}&gt;
          &lt;svg width="32" height="32" viewBox="0 0 24 24" fill="none"&gt;
            &lt;path d="M20 7H4C2.9 7 2 7.9 2 9V19C2 20.1 2.9 21 4 21H20C21.1 21 22 20.1 22 19V9C22 7.9 21.1 7 20 7Z" fill="#74c69d" stroke="#52b788" strokeWidth="1.5"/&gt;
            &lt;path d="M16 7V5C16 3.9 15.1 3 14 3H10C8.9 3 8 3.9 8 5V7" stroke="#52b788" strokeWidth="1.5" strokeLinecap="round"/&gt;
            &lt;path d="M12 12V16M10 14H14" stroke="white" strokeWidth="1.5" strokeLinecap="round"/&gt;
          &lt;/svg&gt;
          &lt;span style={{ color: 'white', fontSize: '1.5rem', fontWeight: '800', letterSpacing: '-0.5px' }}&gt;
            Postal&lt;span style={{ color: '#95d5b2' }}&gt;Track&lt;/span&gt;
          &lt;/span&gt;
        &lt;/div&gt;
        &lt;div style={{ display: 'flex', gap: '10px', alignItems: 'center' }}&gt;
          &lt;Link to="/track" style={{ textDecoration: 'none' }}&gt;
            &lt;span style={{ color: 'rgba(255,255,255,0.8)', fontSize: '0.9rem', padding: '8px 16px', cursor: 'pointer' }}&gt;Track Parcel&lt;/span&gt;
          &lt;/Link&gt;
          {token ? (
            &lt;&gt;
              &lt;Link to="/dashboard" style={{ textDecoration: 'none' }}&gt;
                &lt;button style={{
                  padding: '9px 22px',
                  background: 'rgba(116,198,157,0.2)',
                  color: '#95d5b2', border: '1px solid rgba(116,198,157,0.4)',
                  borderRadius: '8px', cursor: 'pointer', fontWeight: '600', fontSize: '0.88rem'
                }}&gt;Dashboard&lt;/button&gt;
              &lt;/Link&gt;
              &lt;button onClick={handleLogout} style={{
                padding: '9px 22px',
                background: 'rgba(255,100,100,0.2)',
                color: '#ffaaaa', border: '1px solid rgba(255,100,100,0.3)',
                borderRadius: '8px', cursor: 'pointer', fontWeight: '600', fontSize: '0.88rem'
              }}&gt;Logout&lt;/button&gt;
            &lt;/&gt;
          ) : (
            &lt;&gt;
              &lt;Link to="/login" style={{ textDecoration: 'none' }}&gt;
                &lt;button style={{
                  padding: '9px 22px', background: 'transparent',
                  color: 'rgba(255,255,255,0.85)', border: '1px solid rgba(255,255,255,0.25)',
                  borderRadius: '8px', cursor: 'pointer', fontWeight: '500', fontSize: '0.88rem'
                }}&gt;Sign In&lt;/button&gt;
              &lt;/Link&gt;
              &lt;Link to="/register" style={{ textDecoration: 'none' }}&gt;
                &lt;button style={{
                  padding: '9px 22px',
                  background: 'linear-gradient(135deg, #52b788, #95d5b2)',
                  color: 'white', border: 'none',
                  borderRadius: '8px', cursor: 'pointer', fontWeight: '700', fontSize: '0.88rem',
                  boxShadow: '0 4px 15px rgba(82,183,136,0.45)'
                }}&gt;Get Started&lt;/button&gt;
              &lt;/Link&gt;
            &lt;/&gt;
          )}
        &lt;/div&gt;
      &lt;/nav&gt;

      {/* HERO - TROPICAL NATURE INSPIRED */}
      &lt;div style={{
        minHeight: '100vh',
        background: <code class="user-message-inline-code">
</code>          radial-gradient(ellipse at 10% 40%, rgba(255,200,80,0.18) 0%, transparent 40%),
          radial-gradient(ellipse at 90% 10%, rgba(100,220,200,0.2) 0%, transparent 35%),
          radial-gradient(ellipse at 60% 70%, rgba(30,120,80,0.35) 0%, transparent 45%),
          radial-gradient(ellipse at 20% 80%, rgba(0,100,80,0.3) 0%, transparent 40%),
          radial-gradient(ellipse at 80% 60%, rgba(20,80,120,0.25) 0%, transparent 40%),
          linear-gradient(150deg, 
            #1a4d2e 0%, 
            #2d7a4f 15%, 
            #3a9162 30%, 
            #2a6e55 45%, 
            #1e5f74 60%, 
            #134a6e 75%, 
            #0f3854 100%
          )
        <code class="user-message-inline-code">,
</code>        display: 'flex', alignItems: 'center',
        padding: '0 80px', paddingTop: '80px',
        position: 'relative', overflow: 'hidden'
      }}&gt;

